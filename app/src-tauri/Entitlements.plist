<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 정식 서명(하드런타임)을 하면 마이크는 이 entitlement가 있어야 쓸 수 있다 (녹음 헬퍼가 이 앱의 권한으로 녹음함).
     지금 배포는 ad-hoc 서명이고 하드런타임을 켜지 않으므로 이 entitlement는 아직 하는 일이 없다 (켜면 ad-hoc 라이브러리를 불러오지 못한다: scripts/build_app_bundle.sh).
     시스템 오디오(process tap)는 entitlement가 없고 Info.plist의 NSAudioCaptureUsageDescription만 필요하다. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>

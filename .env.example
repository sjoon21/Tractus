# Tractus 개발 환경변수 템플릿. 이 파일만 커밋한다.
#   .env        비밀이 아닌 개발 기본값 (경로, 공급자 선택)
#   .env.local  API 키와 개인 설정
# 우선순위: 셸 환경변수 > .env.local > .env  (저장소 루트에서 tractus를 실행할 때만 읽음)
# $TRACTUS_HOME(노트 폴더)의 .env도 읽는다. 동기화·공유되는 폴더라면 TRACTUS_LLM_BASE_URL을 거기 두지 않는다 (키가 그 주소로 간다)

# ── 경로 ──────────────────────────────────────────────
TRACTUS_HOME=~/Tractus            # 회의 폴더(meetings/), glossary.md 위치
TRACTUS_MODELS_DIR=./models       # ASR·VAD 모델 위치 (README "모델 받기")

# ── LLM ───────────────────────────────────────────────
# 데스크톱 앱은 설정 화면에서 고른 서비스(그 서비스의 주소·AI 모델·키)가 먼저다. 이 값들은 터미널에서 tractus를 쓸 때의 기본값이다
TRACTUS_LLM_PROVIDER=upstage      # upstage | openai | claude | gemini | custom | gemma-local
TRACTUS_LLM_MODEL=                # 비우면 공급자 기본값 (upstage: solar-pro4, claude: claude-sonnet-5-5, gemini: gemini-flash-latest). openai·custom은 필수
TRACTUS_LLM_BASE_URL=             # 비우면 공급자 기본 주소. http(s)://호스트[:포트]/경로 (계정 정보 불가). custom은 필수 (예: https://openrouter.ai/api/v1)
# 서비스별 주소·AI 모델 (비우면 서비스 기본값). 우선순위: 인수 > 전역 TRACTUS_LLM_BASE_URL·TRACTUS_LLM_MODEL(TRACTUS_LLM_PROVIDER가 그 서비스이거나 비었을 때만) > 아래 서비스별 > 기본값
# 기본 AI 모델: upstage solar-pro4, claude claude-sonnet-5-5, gemini gemini-flash-latest. openai는 AI 모델이 필수
# Gemini 주소는 https://generativelanguage.googleapis.com/v1beta/openai (AI 모델 ID 목록: tractus llm models --provider gemini)
UPSTAGE_BASE_URL=
UPSTAGE_MODEL=
OPENAI_BASE_URL=
OPENAI_MODEL=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
GEMINI_BASE_URL=
GEMINI_MODEL=
TRACTUS_LOCAL_ONLY=               # 1이면 호스트가 localhost·127.0.0.1·::1이 아닌 LLM을 차단 (gemma-local, localhost 주소만 허용)

# ── API 키 (.env.local에 둔다) ─────────────────────────
UPSTAGE_API_KEY=                  # https://console.upstage.ai (검색 임베딩에도 같은 키를 쓴다)
GEMINI_API_KEY=                   # https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=                # https://console.anthropic.com
OPENAI_API_KEY=                   # https://platform.openai.com/api-keys
TRACTUS_LLM_API_KEY=              # custom(직접 입력)의 키. 주소가 localhost(Ollama 등)면 비워도 된다

# ── 검색 임베딩 ───────────────────────────────────────
# 비우거나 local이면 내 Mac의 모델로 만든다. upstage면 노트의 문장(색인할 때)과 검색어(검색할 때)가 Upstage(solar-embedding-2)로 전송된다.
# 필요한 것: UPSTAGE_API_KEY. 주소는 UPSTAGE_BASE_URL (전역 TRACTUS_LLM_BASE_URL은 읽지 않는다). 바꾸면 벡터가 다시 만들어진다
TRACTUS_EMBED=

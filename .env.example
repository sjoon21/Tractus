# Tractus 개발 환경변수 템플릿. 이 파일만 커밋한다.
#   .env        비밀이 아닌 개발 기본값 (경로, 공급자 선택)
#   .env.local  API 키와 개인 설정
# 우선순위: 셸 환경변수 > .env.local > .env  (저장소 루트에서 tractus를 실행할 때만 읽음)

# ── 경로 ──────────────────────────────────────────────
TRACTUS_HOME=~/Tractus            # 회의 폴더(meetings/), glossary.md 위치
TRACTUS_MODELS_DIR=./models       # ASR·VAD 모델 위치 (README "모델 받기")

# ── LLM ───────────────────────────────────────────────
TRACTUS_LLM_PROVIDER=upstage      # upstage | openai | claude | gemini | gemma-local
TRACTUS_LLM_MODEL=                # 비우면 공급자 기본값 (upstage: solar-pro4, claude: claude-sonnet-5-5)
TRACTUS_LOCAL_ONLY=               # 1이면 원격 LLM 차단 (gemma-local만 허용)

# ── API 키 (.env.local에 둔다) ─────────────────────────
UPSTAGE_API_KEY=                  # https://console.upstage.ai
GEMINI_API_KEY=                   # https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=                # https://console.anthropic.com
OPENAI_API_KEY=                   # https://platform.openai.com/api-keys
